# APPLICATION PROPERTIES
NODE_ENV=development
API_PORT=3000
TIMEOUT=12000

# CORS
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Origin,X-Requested-With,Accept,Access-Control-Allow-Origin
CORS_EXPOSED_HEADERS=Content-Type,Authorization,Origin,X-Requested-With,Accept,Access-Control-Allow-Origin
CORS_CREDENTIALS=true

# DATABASE PROPERTIES
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=template-postgres

# CACHE REDIS
CACHE_HOST=template-redis
CACHE_PORT=6379
CACHE_PASSWORD=myStrongPassword

# JWT_SECRET
JWT_SECRET=superSecretKey

# EXTERNAL APIS
API_CONTENTFUL=https://cdn.contentful.com/spaces/9xs1613l9f7v/environments/master/entries?access_token=I-ThsT55eE_B3sCUWEQyDT4VqVO3x__20ufuie9usns&content_type=product